<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PICU Sense &#183; Feedback</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--bg:#eef1f5;--surface:#fff;--surface2:#f4f7fb;--border:#dde3ec;--c1:#2E4259;--c2:#5E7F9E;--c3:#8AAAC8;--c4:#3D5469;--accent:#4A90D9;--accent-soft:#e8f1fb;--text:#1e2d3d;--text2:#5a6a7a;--text3:#8a9aaa;--shadow:0 2px 12px rgba(46,66,89,.10);--shadow-md:0 6px 28px rgba(46,66,89,.13);--radius:14px;--radius-sm:8px}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"DM Sans",sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
.nav{background:var(--c1);padding:0 16px;display:flex;align-items:center;justify-content:space-between;height:60px;box-shadow:0 2px 12px rgba(0,0,0,.18)}
.nav-logo{height:34px;width:auto}
.nav-tabs{display:flex;gap:4px}
.nav-tab{padding:7px 14px;border-radius:8px;border:none;font-family:"DM Sans",sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:all .2s;color:rgba(255,255,255,.6);background:transparent}
.nav-tab.active{background:rgba(255,255,255,.15);color:#fff}
.nav-tab:hover:not(.active){background:rgba(255,255,255,.08);color:rgba(255,255,255,.85)}
.page{display:none}.page.active{display:block}
.submit-hero{background:linear-gradient(160deg,var(--c1) 0%,var(--c4) 100%);padding:32px 24px 24px;text-align:center;color:white}
.submit-hero h1{font-size:22px;font-weight:700;margin-bottom:6px}
.submit-hero p{font-size:14px;color:rgba(255,255,255,.72);line-height:1.5}
.tools-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;padding:20px 16px;max-width:700px;margin:0 auto}
.tool-btn{background:var(--surface);border:2px solid var(--border);border-radius:var(--radius);padding:16px 10px 12px;cursor:pointer;transition:all .2s;text-align:center;box-shadow:var(--shadow);position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;gap:6px;width:100%}
.tool-btn::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--c3),var(--c2));transform:scaleX(0);transition:transform .2s}
.tool-btn:hover{border-color:var(--c2);transform:translateY(-2px);box-shadow:var(--shadow-md)}
.tool-btn:hover::before{transform:scaleX(1)}
.tool-icon{font-size:26px}.tool-name{font-size:12px;font-weight:600;color:var(--c1);line-height:1.3}
.tool-link-badge{font-size:10px;color:var(--c2);background:var(--accent-soft);border-radius:10px;padding:2px 8px;margin-top:2px}
.modal-overlay{position:fixed;inset:0;background:rgba(10,20,35,.55);backdrop-filter:blur(4px);display:flex;align-items:flex-end;justify-content:center;z-index:100;opacity:0;pointer-events:none;transition:opacity .25s}
.modal-overlay.open{opacity:1;pointer-events:all}
.modal{background:var(--surface);border-radius:20px 20px 0 0;padding:24px 20px 36px;width:100%;max-width:540px;transform:translateY(30px);transition:transform .3s cubic-bezier(.34,1.56,.64,1);box-shadow:0 -8px 40px rgba(0,0,0,.18);max-height:90vh;overflow-y:auto}
.modal-overlay.open .modal{transform:translateY(0)}
.modal-handle{width:40px;height:4px;background:var(--border);border-radius:2px;margin:0 auto 18px}
.modal-tool-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:10px;flex-wrap:wrap}
.modal-tool-label{display:inline-flex;align-items:center;gap:8px;background:var(--accent-soft);color:var(--accent);padding:6px 14px;border-radius:20px;font-size:13px;font-weight:600}
.btn-open-tool{display:inline-flex;align-items:center;gap:6px;background:var(--c1);color:white;border:none;border-radius:8px;padding:7px 14px;font-family:"DM Sans",sans-serif;font-size:12px;font-weight:600;cursor:pointer;text-decoration:none;transition:opacity .2s;white-space:nowrap}
.btn-open-tool:hover{opacity:.85}
.form-group{margin-bottom:14px}
.form-label{display:block;font-size:11px;font-weight:600;color:var(--text2);margin-bottom:5px;text-transform:uppercase;letter-spacing:.5px}
.form-input,.form-textarea{width:100%;background:var(--surface2);border:1.5px solid var(--border);border-radius:var(--radius-sm);padding:10px 13px;font-family:"DM Sans",sans-serif;font-size:14px;color:var(--text);outline:none;transition:border-color .2s}
.form-input:focus,.form-textarea:focus{border-color:var(--c2);background:white}
.form-textarea{resize:vertical;min-height:95px;line-height:1.5}
.char-count{font-size:11px;color:var(--text3);text-align:right;margin-top:3px}
.upload-area{border:2px dashed var(--border);border-radius:var(--radius-sm);padding:14px;text-align:center;cursor:pointer;transition:all .2s;background:var(--surface2);position:relative;min-height:60px;display:flex;align-items:center;justify-content:center}
.upload-area:hover{border-color:var(--c2);background:var(--accent-soft)}
.upload-area.has-image{border-color:var(--c2);background:var(--accent-soft);padding:8px}
.upload-area input[type=file]{display:none}
.upload-hint{font-size:13px;color:var(--text3);pointer-events:none;text-align:center}
.upload-hint span{font-size:20px;display:block;margin-bottom:3px}
.preview-img{max-width:100%;max-height:160px;border-radius:8px;display:none;margin:0 auto;pointer-events:none}
.remove-img{position:absolute;top:5px;right:5px;background:#e74c3c;color:white;border:none;border-radius:50%;width:22px;height:22px;font-size:12px;cursor:pointer;display:none;align-items:center;justify-content:center;font-weight:700;z-index:2}
.img-warn{font-size:11px;color:#e74c3c;margin-top:3px;display:none}
.btn-submit{width:100%;background:linear-gradient(135deg,var(--c1),var(--c2));color:white;border:none;border-radius:var(--radius-sm);padding:13px;font-family:"DM Sans",sans-serif;font-size:15px;font-weight:600;cursor:pointer;transition:all .2s;margin-top:6px}
.btn-submit:hover{opacity:.92;transform:translateY(-1px)}.btn-submit:disabled{opacity:.6;cursor:not-allowed;transform:none}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--c1);color:white;padding:12px 22px;border-radius:30px;font-size:14px;font-weight:500;box-shadow:var(--shadow-md);transition:transform .3s cubic-bezier(.34,1.56,.64,1);z-index:200;white-space:nowrap}
.toast.show{transform:translateX(-50%) translateY(0)}.toast.success{background:#1a7a45}.toast.error{background:#c0392b}
.dash-header{background:linear-gradient(160deg,var(--c1) 0%,var(--c4) 100%);padding:28px 24px 20px;color:white}
.dash-header h1{font-size:20px;font-weight:700;margin-bottom:4px}
.dash-header p{font-size:13px;color:rgba(255,255,255,.65)}
.dash-controls{padding:14px 16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;max-width:900px;margin:0 auto}
.dash-filter{background:var(--surface);border:1.5px solid var(--border);border-radius:8px;padding:7px 12px;font-family:"DM Sans",sans-serif;font-size:13px;color:var(--text);outline:none;cursor:pointer}
.dash-filter:focus{border-color:var(--c2)}
.btn-refresh{background:var(--c1);color:white;border:none;border-radius:8px;padding:7px 14px;font-family:"DM Sans",sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:opacity .2s;margin-left:auto}
.btn-refresh:hover{opacity:.85}
.dash-stats{display:flex;gap:10px;padding:0 16px 14px;max-width:900px;margin:0 auto;flex-wrap:wrap}
.stat-card{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--radius-sm);padding:11px 16px;flex:1;min-width:90px;box-shadow:var(--shadow)}
.stat-num{font-size:24px;font-weight:700;color:var(--c1);font-family:"DM Mono",monospace;line-height:1}
.stat-label{font-size:11px;color:var(--text3);margin-top:3px;text-transform:uppercase;letter-spacing:.4px}
.dash-content{padding:0 16px 32px;max-width:900px;margin:0 auto}
.tool-section{margin-bottom:20px;background:var(--surface);border-radius:var(--radius);border:1.5px solid var(--border);overflow:hidden;box-shadow:var(--shadow)}
.tool-section-header{background:var(--surface2);padding:13px 18px;display:flex;align-items:center;justify-content:space-between;border-bottom:1.5px solid var(--border);cursor:pointer;user-select:none}
.tool-section-header:hover{background:#edf2f8}
.tool-section-title{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:700;color:var(--c1)}
.tool-count-badge{background:var(--c2);color:white;border-radius:20px;padding:2px 10px;font-size:12px;font-weight:600}
.section-toggle{color:var(--text3);font-size:18px;transition:transform .2s}
.tool-section.collapsed .section-toggle{transform:rotate(-90deg)}
.tool-section.collapsed .section-body{display:none}
.feedback-item{padding:13px 18px;border-bottom:1px solid var(--border);display:flex;gap:12px;align-items:flex-start;transition:background .15s}
.feedback-item:last-child{border-bottom:none}.feedback-item:hover{background:var(--surface2)}
.feedback-avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--c3),var(--c2));display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:white;flex-shrink:0;font-family:"DM Mono",monospace}
.feedback-body{flex:1;min-width:0}
.feedback-meta{display:flex;align-items:center;gap:8px;margin-bottom:4px;flex-wrap:wrap}
.feedback-author{font-size:13px;font-weight:600;color:var(--c1)}
.feedback-anon{font-size:12px;color:var(--text3);font-style:italic}
.feedback-time{font-size:11px;color:var(--text3);font-family:"DM Mono",monospace;margin-left:auto}
.feedback-note{font-size:14px;color:var(--text);line-height:1.55}
.feedback-screenshot{max-width:100%;max-height:200px;border-radius:8px;border:1px solid var(--border);cursor:pointer;transition:opacity .2s;display:block;margin-top:8px}
.feedback-screenshot:hover{opacity:.9}
.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.85);display:flex;align-items:center;justify-content:center;z-index:300;opacity:0;pointer-events:none;transition:opacity .2s}
.lightbox.open{opacity:1;pointer-events:all}
.lightbox img{max-width:92vw;max-height:88vh;border-radius:10px}
.lightbox-close{position:absolute;top:16px;right:20px;color:white;font-size:32px;cursor:pointer;line-height:1}
.empty-state{padding:32px 20px;text-align:center;color:var(--text3);font-size:14px}
.empty-icon{font-size:30px;margin-bottom:8px}
.loading-state{padding:48px 20px;text-align:center;color:var(--text3);font-size:14px}
.spinner{width:30px;height:30px;border:3px solid var(--border);border-top-color:var(--c2);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 12px}
@keyframes spin{to{transform:rotate(360deg)}}
.footer{text-align:center;padding:18px;font-size:12px;color:var(--text3);border-top:1px solid var(--border)}
@media(max-width:480px){.tools-grid{grid-template-columns:repeat(2,1fr);gap:10px;padding:14px}.nav-tab{padding:6px 10px;font-size:12px}}
</style>
</head>
<body>
<nav class="nav">
  <img class="nav-logo" src="data:image/png;base64," alt="PICU Sense">
  <div class="nav-tabs">
    <button class="nav-tab active" id="tab-submit" onclick="showPage('submit')">&#9998; Feedback</button>
    <button class="nav-tab" id="tab-dashboard" onclick="showPage('dashboard')">&#128202; Dashboard</button>
  </div>
</nav>

<div class="page active" id="page-submit">
  <div class="submit-hero">
    <h1>Share Your Feedback</h1>
    <p>Select a tool and leave your comments or suggestions.</p>
  </div>
  <div class="tools-grid" id="toolsGrid"></div>
  <div class="footer">PICU Sense &middot; Making Sense of PICU &middot; Dr. R. Be&#8217;eri</div>
</div>

<div class="page" id="page-dashboard">
  <div class="dash-header">
    <h1>&#128202; Feedback Dashboard</h1>
    <p>All submitted feedback, grouped by tool</p>
  </div>
  <div class="dash-controls">
    <select class="dash-filter" id="filterTool" onchange="renderDashboard()">
      <option value="">All Tools</option>
    </select>
    <select class="dash-filter" id="filterSort" onchange="renderDashboard()">
      <option value="newest">Newest first</option>
      <option value="oldest">Oldest first</option>
    </select>
    <button class="btn-refresh" onclick="loadFeedback()">&#8635; Refresh</button>
  </div>
  <div class="dash-stats" id="dashStats"></div>
  <div class="dash-content" id="dashContent">
    <div class="loading-state"><div class="spinner"></div>Loading...</div>
  </div>
  <div class="footer">PICU Sense &middot; Making Sense of PICU &middot; Dr. R. Be&#8217;eri</div>
</div>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <div class="modal-handle"></div>
    <div class="modal-tool-header">
      <div class="modal-tool-label" id="modalToolLabel">Tool</div>
      <a class="btn-open-tool" id="btnOpenTool" href="#" target="_blank" rel="noopener" style="display:none">Open Tool &#8599;</a>
    </div>
    <div class="form-group">
      <label class="form-label">Your name (optional)</label>
      <input class="form-input" id="authorInput" type="text" placeholder="Anonymous" maxlength="60">
    </div>
    <div class="form-group">
      <label class="form-label">Comment / Suggestion *</label>
      <textarea class="form-textarea" id="noteInput" placeholder="Write your feedback here..." maxlength="600"></textarea>
      <div class="char-count"><span id="charCount">0</span> / 600</div>
    </div>
    <div class="form-group">
      <label class="form-label">Screenshot (optional)</label>
      <div class="upload-area" id="uploadArea">
        <input type="file" id="fileInput" accept="image/*">
        <div class="upload-hint" id="uploadHint"><span>&#128247;</span>Tap to attach a screenshot</div>
        <img class="preview-img" id="previewImg" alt="preview">
        <button class="remove-img" id="removeImg" type="button">&#10005;</button>
      </div>
      <div class="img-warn" id="imgWarn">Image too large (max 900KB). Please compress first.</div>
    </div>
    <button class="btn-submit" id="submitBtn" type="button">Send Feedback</button>
  </div>
</div>

<div class="lightbox" id="lightbox">
  <span class="lightbox-close">&#10005;</span>
  <img id="lightboxImg" src="" alt="screenshot">
</div>

<div class="toast" id="toast"></div>
<script>
var SUPABASE_URL = "https://mndsmuflhsiosvxkwwpu.supabase.co";
var SUPABASE_KEY = "sb_publishable_GnpE6vgpiqJia6N5KMJ7rA_RyMWhyhG";
var db = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

var TOOLS = [
  { name:"PICU Antibiotic Navigator", icon:"🦠", url:"https://picu-navigator.vercel.app/" },
  { name:"Opioid Conversion Calculator", icon:"💊", url:"https://picu-opioid-calculator.vercel.app/" },
  { name:"LeNa \u2013 Sodium Correction", icon:"🧂", url:"" },
  { name:"Weight Adaptor Calculator", icon:"⚖️", url:"https://picu-sense-weight-adaptor-calculato.vercel.app/" },
  { name:"Effective FiO\u2082", icon:"🫁", url:"" },
  { name:"Blood Gas Analysis", icon:"🩸", url:"" },
  { name:"MaBaDa", icon:"🔬", url:"https://fastidious-sable-525df0.netlify.app/" }
];

var allFeedback = [];
var currentTool = null;
var currentImageB64 = null;

(function buildGrid() {
  var grid = document.getElementById("toolsGrid");
  var filterSel = document.getElementById("filterTool");
  TOOLS.forEach(function(t) {
    var btn = document.createElement("button");
    btn.className = "tool-btn";
    btn.innerHTML = '<span class="tool-icon">' + t.icon + '</span>' +
      '<span class="tool-name">' + t.name + '</span>' +
      (t.url ? '<span class="tool-link-badge">&#8599; open</span>' : '');
    btn.addEventListener("click", function() { openModal(t); });
    grid.appendChild(btn);
    var opt = document.createElement("option");
    opt.value = t.name; opt.textContent = t.name;
    filterSel.appendChild(opt);
  });
})();

function showPage(name) {
  document.querySelectorAll(".page").forEach(function(p){ p.classList.remove("active"); });
  document.querySelectorAll(".nav-tab").forEach(function(t){ t.classList.remove("active"); });
  document.getElementById("page-" + name).classList.add("active");
  document.getElementById("tab-" + name).classList.add("active");
  if (name === "dashboard") loadFeedback();
}

function openModal(tool) {
  currentTool = tool;
  currentImageB64 = null;
  document.getElementById("modalToolLabel").textContent = tool.icon + " " + tool.name;
  document.getElementById("authorInput").value = "";
  document.getElementById("noteInput").value = "";
  document.getElementById("charCount").textContent = "0";
  document.getElementById("submitBtn").disabled = false;
  document.getElementById("submitBtn").textContent = "Send Feedback";
  document.getElementById("previewImg").style.display = "none";
  document.getElementById("uploadHint").style.display = "";
  document.getElementById("removeImg").style.display = "none";
  document.getElementById("uploadArea").classList.remove("has-image");
  document.getElementById("imgWarn").style.display = "none";
  document.getElementById("fileInput").value = "";
  var btnOpen = document.getElementById("btnOpenTool");
  if (tool.url) { btnOpen.href = tool.url; btnOpen.style.display = "inline-flex"; }
  else { btnOpen.style.display = "none"; }
  document.getElementById("modalOverlay").classList.add("open");
}

function closeModal() {
  document.getElementById("modalOverlay").classList.remove("open");
}

document.getElementById("modalOverlay").addEventListener("click", function(e) {
  if (e.target === this) closeModal();
});

document.getElementById("noteInput").addEventListener("input", function() {
  document.getElementById("charCount").textContent = this.value.length;
});

document.getElementById("uploadArea").addEventListener("click", function() {
  document.getElementById("fileInput").click();
});
document.getElementById("fileInput").addEventListener("change", function(e) {
  var file = e.target.files[0];
  if (!file) return;
  if (file.size > 900000) { document.getElementById("imgWarn").style.display = "block"; return; }
  document.getElementById("imgWarn").style.display = "none";
  var reader = new FileReader();
  reader.onload = function(ev) {
    currentImageB64 = ev.target.result;
    var img = document.getElementById("previewImg");
    img.src = currentImageB64; img.style.display = "block";
    document.getElementById("uploadHint").style.display = "none";
    document.getElementById("removeImg").style.display = "flex";
    document.getElementById("uploadArea").classList.add("has-image");
  };
  reader.readAsDataURL(file);
});
document.getElementById("removeImg").addEventListener("click", function(e) {
  e.stopPropagation();
  currentImageB64 = null;
  document.getElementById("previewImg").style.display = "none";
  document.getElementById("uploadHint").style.display = "";
  document.getElementById("removeImg").style.display = "none";
  document.getElementById("uploadArea").classList.remove("has-image");
  document.getElementById("fileInput").value = "";
});

document.getElementById("submitBtn").addEventListener("click", function() {
  var note = document.getElementById("noteInput").value.trim();
  var author = document.getElementById("authorInput").value.trim() || null;
  if (!note) { showToast("Please write a comment first.", "error"); return; }
  var btn = document.getElementById("submitBtn");
  btn.disabled = true; btn.textContent = "Sending...";
  var payload = { tool: currentTool.name, author: author, note: note };
  if (currentImageB64) payload.screenshot = currentImageB64;
  db.from("feedback").insert(payload).then(function(res) {
    if (res.error) {
      showToast("Error: " + res.error.message, "error");
      btn.disabled = false; btn.textContent = "Send Feedback";
    } else {
      closeModal();
      showToast("\u2713 Feedback sent \u2014 thank you!", "success");
    }
  });
});

function loadFeedback() {
  document.getElementById("dashContent").innerHTML =
    '<div class="loading-state"><div class="spinner"></div>Loading feedback...</div>';
  db.from("feedback").select("*").order("created_at", { ascending: false }).then(function(res) {
    if (res.error) {
      document.getElementById("dashContent").innerHTML =
        '<div class="empty-state"><div class="empty-icon">&#9888;</div>Error loading data</div>';
      return;
    }
    allFeedback = res.data || [];
    renderDashboard();
  });
}

function renderDashboard() {
  var filterTool = document.getElementById("filterTool").value;
  var sortOrder = document.getElementById("filterSort").value;
  var data = allFeedback.slice();
  if (filterTool) data = data.filter(function(f){ return f.tool === filterTool; });
  if (sortOrder === "oldest") data.sort(function(a,b){ return new Date(a.created_at) - new Date(b.created_at); });
  var total = data.length;
  var toolsN = new Set(data.map(function(f){ return f.tool; })).size;
  var today = data.filter(function(f){ return new Date(f.created_at).toDateString() === new Date().toDateString(); }).length;
  document.getElementById("dashStats").innerHTML =
    '<div class="stat-card"><div class="stat-num">'+total+'</div><div class="stat-label">Total</div></div>' +
    '<div class="stat-card"><div class="stat-num">'+toolsN+'</div><div class="stat-label">Tools</div></div>' +
    '<div class="stat-card"><div class="stat-num">'+today+'</div><div class="stat-label">Today</div></div>';
  if (!data.length) {
    document.getElementById("dashContent").innerHTML =
      '<div class="empty-state"><div class="empty-icon">&#128172;</div>No feedback yet</div>';
    return;
  }
  var grouped = {};
  TOOLS.forEach(function(t){ grouped[t.name] = []; });
  data.forEach(function(f){ if (!grouped[f.tool]) grouped[f.tool] = []; grouped[f.tool].push(f); });
  var toolOrder = filterTool ? [filterTool] : TOOLS.map(function(t){ return t.name; });
  var html = "";
  toolOrder.forEach(function(toolName) {
    var items = grouped[toolName] || [];
    if (!filterTool && !items.length) return;
    var toolObj = TOOLS.find(function(t){ return t.name === toolName; }) || { icon:"📋" };
    var secId = "sec" + toolName.replace(/[^a-zA-Z0-9]/g,"");
    html += '<div class="tool-section" id="' + secId + '">' +
      '<div class="tool-section-header" data-sec="' + secId + '">' +
        '<div class="tool-section-title"><span>' + toolObj.icon + '</span><span>' + esc(toolName) + '</span>' +
          '<span class="tool-count-badge">' + items.length + '</span></div>' +
        '<span class="section-toggle">&#9662;</span>' +
      '</div><div class="section-body">';
    if (!items.length) {
      html += '<div class="empty-state"><div class="empty-icon">&#128172;</div>No feedback yet</div>';
    } else {
      items.forEach(function(f) {
        var initials = f.author ? f.author.slice(0,2).toUpperCase() : "?";
        var scr = f.screenshot ? '<img class="feedback-screenshot" data-src="'+esc(f.screenshot)+'" src="'+esc(f.screenshot)+'" alt="screenshot">' : "";
        html += '<div class="feedback-item">' +
          '<div class="feedback-avatar">' + initials + '</div>' +
          '<div class="feedback-body">' +
            '<div class="feedback-meta">' +
              (f.author ? '<span class="feedback-author">'+esc(f.author)+'</span>' : '<span class="feedback-anon">Anonymous</span>') +
              '<span class="feedback-time">' + formatTime(f.created_at) + '</span>' +
            '</div>' +
            '<div class="feedback-note">' + esc(f.note) + '</div>' + scr +
          '</div></div>';
      });
    }
    html += '</div></div>';
  });
  document.getElementById("dashContent").innerHTML = html;
  document.querySelectorAll(".tool-section-header").forEach(function(h) {
    h.addEventListener("click", function() {
      document.getElementById(this.getAttribute("data-sec")).classList.toggle("collapsed");
    });
  });
  document.querySelectorAll(".feedback-screenshot").forEach(function(img) {
    img.addEventListener("click", function() { openLightbox(this.getAttribute("data-src")); });
  });
}

function openLightbox(src) {
  document.getElementById("lightboxImg").src = src;
  document.getElementById("lightbox").classList.add("open");
}
document.getElementById("lightbox").addEventListener("click", function() { this.classList.remove("open"); });

function formatTime(ts) {
  var d = new Date(ts), now = new Date(), diff = Math.floor((now - d) / 1000);
  if (diff < 60) return "just now";
  if (diff < 3600) return Math.floor(diff/60) + "m ago";
  if (diff < 86400) return Math.floor(diff/3600) + "h ago";
  return d.toLocaleDateString("en-GB", { day:"2-digit", month:"short" });
}
function esc(s) {
  return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}
function showToast(msg, type) {
  var t = document.getElementById("toast");
  t.textContent = msg;
  t.className = "toast show" + (type ? " " + type : "");
  setTimeout(function(){ t.className = "toast"; }, 3000);
}
</script>
